# Salin ke .env untuk mengaktifkan asisten AI (opsional). Tanpa dua nilai ini, AI mati dan aplikasi tetap berfungsi penuh.
# Kunci milik Anda sendiri. Jangan pernah di-commit (.env sudah di .gitignore).
ANTHROPIC_API_KEY=
# Nama model dari akun Anda, mis. salah satu ID model yang tersedia di dokumentasi Anthropic.
ANTHROPIC_MODEL=
